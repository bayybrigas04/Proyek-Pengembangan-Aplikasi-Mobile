CREATE TABLE PrayerTimeEntity (
    id          INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    date        TEXT    NOT NULL,
    fajr        TEXT    NOT NULL,
    sunrise     TEXT    NOT NULL,
    dhuhr       TEXT    NOT NULL,
    asr         TEXT    NOT NULL,
    maghrib     TEXT    NOT NULL,
    isha        TEXT    NOT NULL,
    imsak       TEXT    NOT NULL,
    midnight    TEXT    NOT NULL,
    latitude    REAL    NOT NULL,
    longitude   REAL    NOT NULL,
    city_name   TEXT    NOT NULL DEFAULT ''
);

-- Tabel untuk CRUD Jadwal Sholat Manual
CREATE TABLE ManualPrayerEntity (
    id              INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    namaSholat      TEXT    NOT NULL,
    waktu           TEXT    NOT NULL,
    lokasi          TEXT    NOT NULL,
    tanggalHijriah  TEXT    NOT NULL
);

-- Queries CRUD ManualPrayer
getAllManualPrayers:
SELECT * FROM ManualPrayerEntity ORDER BY waktu ASC;

insertManualPrayer:
INSERT INTO ManualPrayerEntity (namaSholat, waktu, lokasi, tanggalHijriah)
VALUES (?, ?, ?, ?);

updateManualPrayer:
UPDATE ManualPrayerEntity
SET namaSholat = ?, waktu = ?, lokasi = ?, tanggalHijriah = ?
WHERE id = ?;

deleteManualPrayer:
DELETE FROM ManualPrayerEntity WHERE id = ?;

-- Jadwal otomatis (API Cache)
getPrayerTimeByDate:
SELECT * FROM PrayerTimeEntity WHERE date = ?;

insertPrayerTime:
INSERT OR REPLACE INTO PrayerTimeEntity (date, fajr, sunrise, dhuhr, asr, maghrib, isha, imsak, midnight, latitude, longitude, city_name)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updatePrayerTime:
UPDATE PrayerTimeEntity
SET fajr = ?, sunrise = ?, dhuhr = ?, asr = ?, maghrib = ?, isha = ?, imsak = ?, midnight = ?, city_name = ?
WHERE date = ?;

deletePrayerTimeByDate:
DELETE FROM PrayerTimeEntity WHERE date = ?;
